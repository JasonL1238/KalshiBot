# Copy to .env (gitignored). Only a READ-ONLY prod key goes here. Create it on
# kalshi.com -> Account -> API Keys with scope "read" only (no "write"). It signs
# market-data WebSocket connections (book recording) and read-only account calls.
# Never put a key that can trade (prod or demo) here: order commands take a key path
# argument from you instead.
KALSHI_DATA_KEY_ID=
KALSHI_DATA_KEY_PATH=~/.kalshi/prod-read.pem
# Or the PEM contents directly:
# KALSHI_DATA_KEY=

# Where raw/processed data lives. Relative paths resolve against the repo root.
DATA_DIR=data
