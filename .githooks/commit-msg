#!/bin/sh
# Repo rule: AI agents are never commit authors or co-authors.
# Enable once per clone: git config core.hooksPath .githooks
# AI identities live in ai-identities.txt; other AI trailer/footer lines in ai-attribution.txt.
dir=$(dirname "$0")
ident="($(paste -sd'|' "$dir/ai-identities.txt"))"
for who in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  if git var "$who" | grep -qiE "<[^>]*$ident>"; then
    echo "commit-msg: refusing AI $who: $(git var "$who")" >&2
    exit 1
  fi
done
msg="$1"
{ cat "$dir/ai-attribution.txt"; printf '%s\n' "^[a-z-]+-by:.*<[^>]*$ident>"; } > "$msg.patterns"
grep -v -i -E -f "$msg.patterns" "$msg" > "$msg.tmp"
# Drop trailing blank lines left behind by removed trailers.
awk 'NF { for (; n > 0; n--) print ""; print; next } { n++ }' "$msg.tmp" > "$msg"
rm -f "$msg.tmp" "$msg.patterns"
